<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_import_sph_cyl_matrix_wizard" model="ir.ui.view">
        <field name="name">import.sph.cyl.matrix.wizard.form</field>
        <field name="model">import.sph.cyl.matrix.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Lens Order Matrix">
                <group>
                    <group>
                        <field name="date"/>
                        <field name="partner_id"/>
                        <field name="customer_ref"/>
                        <field name="upload_batch"/>
                    </group>
                    <group>
                        <field name="sheet_name" invisible="1"/>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                        <field name="company_id"/>
                    </group>
                </group>
                <footer>
                    <button name="import_sph_cyl_matrix" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_sph_cyl_matrix" model="ir.actions.act_window">
        <field name="name">Import Lens OrderMatrix</field>
        <field name="res_model">import.sph.cyl.matrix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- wizard view -->
    <menuitem id="menu_import_sph_cyl_matrix"
              name="Upload Lens Order Matrix"
              sequence="30"
              groups="base.group_no_one"
              parent="custom_matrix_table.main_lens_matrix"
              action="custom_matrix_table.action_import_sph_cyl_matrix"/>

</odoo>