<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- SPH Value Views -->
    <record id="view_sph_form" model="ir.ui.view">
        <field name="name">lens.sph.value.form</field>
        <field name="model">lens.sph.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sph_list" model="ir.ui.view">
        <field name="name">lens.sph.value.tree</field>
        <field name="model">lens.sph.value</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- CYL Value Views -->
    <record id="view_cyl_form" model="ir.ui.view">
        <field name="name">lens.cyl.value.form</field>
        <field name="model">lens.cyl.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cyl_list" model="ir.ui.view">
        <field name="name">lens.cyl.value.tree</field>
        <field name="model">lens.cyl.value</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- SPH Value Menu & action -->
    <record id="action_lens_sph" model="ir.actions.act_window">
        <field name="name">SPH Values</field>
        <field name="res_model">lens.sph.value</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="lens_master_menu" name="Lens Values" parent="stock.menu_stock_config_settings"
              sequence="6" groups="uom.group_uom"/>

    <menuitem
            id="menu_lens_sph"
            name="SPH Values"
            parent="lens_master_menu"
            sequence="10"
            action="sale_order_custom_lens.action_lens_sph"/>


    <!-- CYL Value Menu & action -->
    <record id="action_lens_cyl" model="ir.actions.act_window">
        <field name="name">CYL Values</field>
        <field name="res_model">lens.cyl.value</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_lens_cyl"
            name="CYL Values"
            parent="lens_master_menu"
            sequence="20"
            action="sale_order_custom_lens.action_lens_cyl"/>


</odoo>

