<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="sph_cyl_matrix_table">
            <t t-call="web.layout">
                <div class="container mt-3">
                    <style>
                        .btn-save:hover {
                        background: #c5d69c; /* Light gray hover effect */
                        color: #0056b3;
                        border-color: #0056b3;
                        }

                        button.btn-primary {
                        border-radius: 8px; /* Adjust as needed */
                        font-weight: bold;
                        color: white;
                        padding: 8px 16px;
                        background: #6c4c64;
                        }

                        table {
                        width: 100%;
                        border-collapse: collapse;
                        }

                        th, td {
                        border: 1px solid black;
                        text-align: center; /* Center text in all cells */
                        vertical-align: middle; /* Center vertically */
                        padding: 10px; /* Add padding for better spacing */
                        }

                        th {
                        background-color: #007bff;
                        color: white;
                        font-weight: bold;
                        }

                        .editable-cell:focus {
                        outline: 2px solid #007bff;
                        background-color: #eef7ff;
                        }

                        .sticky-header {
                        position: sticky;
                        top: 0;
                        z-index: 2;
                        background-color: #f8f9fa;
                        }

                        .table-container {
                        width: 100%;
                        max-height: 500px; /* Adjust height as needed */
                        overflow: auto; /* Enable scrolling */
                        position: relative;
                        }

                        table {
                        width: 100%;
                        border-collapse: collapse;
                        }

                        th, td {
                        border: 1px solid black;
                        text-align: center;
                        vertical-align: middle;
                        padding: 10px;
                        }

                        /* Sticky Header */
                        th {
                        background-color: #007bff;
                        color: white;
                        font-weight: bold;
                        position: sticky;
                        top: 0;
                        z-index: 10;
                        }

                        /* Sticky First Column */
                        td:first-child, th:first-child {
                        position: sticky;
                        left: 0;
                        background-color: #a7abb0;
                        font-weight: bold;
                        z-index: 20;
                        }

                        /* Optional: Improve Scroll Behavior */
                        .table-container::-webkit-scrollbar {
                        height: 10px;
                        width: 10px;
                        }

                        .table-container::-webkit-scrollbar-thumb {
                        background: #007bff;
                        border-radius: 5px;
                        }

                        .matrix-card-header {
                        background-color: #2596be;
                        color: white;
                        padding: 15px 20px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        border-bottom: 1px solid #dee2e6;
                        }

                        .matrix-title {
                        margin: 0;
                        font-size: 1.25rem;
                        }

                        /* Normal editable cell */
                        .editable-cell {
                        background-color: white;
                        transition: background-color 0.3s ease;
                        }

                        /* Highlight changed cell */
                        .editable-cell.modified {
                        background-color: #ffeb3b !important; /* Yellow highlight */
                        border: 2px solid #ff9800; /* Orange border */
                        }
                    </style>

                    <div class="card shadow-sm">
                        <div class="matrix-card-header">
                            <button id="back" class="btn btn-primary">Back to List</button>
                            <h3 class="matrix-title">Optical Lens Power Matrix Table</h3>
                            <div class="d-flex justify-content-end gap-2 mb-3">

                                <button id="upload_button" class="btn btn-primary">Import Data</button>
                                <button id="export_excel" class="btn btn-primary">Export to Excel</button>
                                <button id="save_matrix" class="btn btn-primary">Save Changes</button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive matrix-scroll">
                                <table class="table table-bordered table-striped table-hover text-center align-middle">
                                    <thead class="sticky-header">
                                        <tr>
                                            <th class="text-center align-middle" style="min-width: 80px;">CYL / SPH</th>
                                            <t t-foreach="sph_values" t-as="sph">
                                                <th class="text-center align-middle" style="min-width: 80px;">
                                                    <t t-esc="sph"/>
                                                </th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="cyl_values" t-as="cyl">
                                            <tr>
                                                <td class="fw-bold text-center align-middle">
                                                    <t t-esc="cyl"/>
                                                </td>
                                                <t t-foreach="sph_values" t-as="sph">
                                                    <td contenteditable="true"
                                                        class="editable-cell text-center bg-white"
                                                        style="min-width: 80px; cursor: pointer;"
                                                        t-att-data-sph="sph" t-att-data-cyl="cyl">
                                                        <t t-esc="values_dict.get((sph, cyl), 0)"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <record id="action_sph_cyl_matrix_html" model="ir.actions.act_url">
            <field name="name">Matrix</field>
            <field name="url">/sph_cyl_matrix</field>
            <field name="target">self</field>
        </record>

        <menuitem id="menu_sph_cyl_matrix_html"
                  name="View Lens Order Matrix"
                  parent="sph_cyl_matrix.main_lens_matrix"
                  sequence="20"
                  action="action_sph_cyl_matrix_html"/>

    </data>
</odoo>

