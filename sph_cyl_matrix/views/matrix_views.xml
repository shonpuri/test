<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sph_cyl_matrix_form" model="ir.ui.view">
        <field name="name">sph.cyl.matrix.form</field>
        <field name="model">sph.cyl.matrix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="cyl"/>
                            <field name="sph"/>
                            <field name="value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sph_cyl_matrix_list" model="ir.ui.view">
        <field name="name">sph.cyl.matrix.tree</field>
        <field name="model">sph.cyl.matrix</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="product_id"/>
                <field name="cyl"/>
                <field name="sph"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <record id="view_sph_cyl_pivot" model="ir.ui.view">
        <field name="name">sph.cyl.pivot</field>
        <field name="model">sph.cyl.matrix</field>
        <field name="arch" type="xml">
            <pivot string="Matrix">
<!--                <button name="import_sph_cyl_matrix" type="object" string="Import Data" class="btn btn-primary"/>-->
                <field name="sph" type="col"/>
                <field name="cyl" type="row"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sph_cyl_matrix" model="ir.actions.act_window">
        <field name="name">Lens Order Matrix</field>
        <field name="res_model">sph.cyl.matrix</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_order': 'sph asc'}</field>
    </record>

    <menuitem
            id="menu_sph_cyl_matrix"
            name="Lens Order Matrix"
            parent="sale.sale_menu_root"
            sequence="60"
            action="action_sph_cyl_matrix"/>
</odoo>